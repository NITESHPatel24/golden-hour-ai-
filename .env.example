# ═══════════════════════════════════════════════
#  GOLDEN HOUR AI — .env
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════

# ── SERVER ──
PORT=3000

# ── JWT ──
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ── TWILIO SMS (get from twilio.com/console) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_ENABLED=false   # set to "true" to send real SMS

# ── GOOGLE OAUTH (console.cloud.google.com) ──
# 1. Create project → APIs & Services → Credentials → OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:3000/auth/google/callback
# 4. npm install passport passport-google-oauth20 express-session
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── GITHUB OAUTH (github.com/settings/developers) ──
# 1. New OAuth App → Homepage URL: http://localhost:3000
# 2. Callback URL: http://localhost:3000/auth/github/callback
# 3. npm install passport passport-github2 express-session
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
